{
  "functions": {
    "api/socket.ts": {
      "maxDuration": 300
    },
    "app/api/chat/messages/route.ts": {
      "maxDuration": 15
    },
    "app/api/**/*.ts": {
      "maxDuration": 5
    },
    "app/api/**/*.tsx": {
      "maxDuration": 5
    },
    "app/api/admin/broadcast/route.tsx": {
      "maxDuration": 60
    },
    "app/api/cron/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/cron/**/*.tsx": {
      "maxDuration": 30
    },
    "app/api/upload/route.ts": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-tip",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/inactivity-reminder",
      "schedule": "0 6 * * *"
    }
  ]
}
