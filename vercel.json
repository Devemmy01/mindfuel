{
  "functions": {
    "app/api/chat/attachments/route.ts": {
      "maxDuration": 15
    },
    "app/api/chat/attachments/[id]/route.ts": {
      "maxDuration": 15
    },
    "app/api/cron/following-digest/route.tsx": {
      "maxDuration": 60
    },
    "app/api/socket/route.ts": {
      "maxDuration": 300
    },
    "app/api/chat/messages/route.ts": {
      "maxDuration": 15
    },
    "app/api/**/*.ts": {
      "maxDuration": 5
    },
    "app/api/**/*.tsx": {
      "maxDuration": 5
    },
    "app/api/admin/broadcast/route.tsx": {
      "maxDuration": 60
    },
    "app/api/cron/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/cron/**/*.tsx": {
      "maxDuration": 30
    },
    "app/api/upload/route.ts": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-tip",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/inactivity-reminder",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/chat-recovery-reminder",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/chat-attachment-sweep",
      "schedule": "0 4 * * *"
    }
  ]
}
