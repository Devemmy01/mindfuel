{
  "id": "/feed",
  "name": "MindFuel",
  "short_name": "MindFuel",
  "description": "Write one honest reflection a day. Read what others learned.",
  "start_url": "/feed?source=pwa",
  "scope": "/",
  "display": "standalone",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "orientation": "any",
  "categories": [
    "social",
    "lifestyle",
    "education"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Write today's reflection",
      "short_name": "Reflect",
      "description": "Open the composer with today's prompt",
      "url": "/create?source=shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Saved",
      "short_name": "Saved",
      "description": "Reflections you saved",
      "url": "/collections?source=shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "My profile",
      "short_name": "Profile",
      "description": "Your streak and reflection history",
      "url": "/profile",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/create",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "share_text",
      "url": "url"
    }
  },
  "screenshots": [
    {
      "src": "/screenshots/home-narrow.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Answer today's prompt in a sentence or two"
    },
    {
      "src": "/screenshots/home-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Write one honest reflection a day"
    }
  ]
}
